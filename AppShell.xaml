<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NylanderMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:NylanderMobile"
    Shell.FlyoutBehavior="Flyout"
    Title="NylanderMobile">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    <ShellContent
        Title="North Gallery"
        ContentTemplate="{DataTemplate local:NorthGallery}"
        Route="NorthGallery" />
    <ShellContent
        Title="South Gallery"
        ContentTemplate="{DataTemplate local:SouthGallery}"
        Route="SouthGallery" />
    <ShellContent
        Title="Archives"
        ContentTemplate="{DataTemplate local:Archives}"
        Route="Archives" />
</Shell>
